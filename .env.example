# Copy to .env at the repo root. .env is gitignored.
#
# There is no API key here on purpose. The key always arrives from the browser
# in the Authorization header, is used inside the one request that carried it,
# and is never written down -- see RELAY.md. Giving the relay its own key would
# make the local relay behave differently from the hosted Worker, and would put
# a key in a file, which is the thing this design is trying not to do.

PORT=8787

# Comma-separated list, or * to allow any origin (fine for localhost).
ALLOWED_ORIGINS=*

# 1 logs full request/response bodies with auth material redacted. Local relay
# only -- the Worker has no logging code path. Use it for prompt iteration and
# for consented playtest transcripts; leave it off otherwise.
DEV_LOG=0

# Optional. Replaces the built-in provider map wholesale. Adding a provider, or
# pointing an existing one somewhere else, is a config change, not a code change.
# PROVIDERS={"anthropic":{"url":"https://api.anthropic.com/v1/messages","auth":"x-api-key","headers":{"anthropic-version":"2023-06-01"}}}
#
# deepseek, opencode, opencode-go and anthropic ship as built-in entries, all
# four speaking Anthropic's Messages format, all four authenticating with
# x-api-key. Pick one in the page's Provider dropdown; the name selects the
# entry here.
#
# Model ids are not portable between them: deepseek-v4-flash on deepseek,
# claude-opus-4-8 on opencode, claude-opus-5 on anthropic. A prefixed id like
# "opencode/claude-opus-4-8" is OpenCode's own config-file syntax for naming a
# provider and a model in one string; only the bare id goes in a request body.
#
# That prefix is also how you tell which OpenCode you are looking at, because
# there are two, sold behind one login and served from two different bases:
#
#   opencode/<id>     Zen  https://opencode.ai/zen/v1/...     -> provider "opencode"
#   opencode-go/<id>  Go   https://opencode.ai/zen/go/v1/...  -> provider "opencode-go"
#
# They are separate subscriptions behind one login, so a key for one has no
# balance on the other and says so in those words rather than in any words about
# the wrong endpoint. Both are built in; pick the one you actually pay for.
#
# Only the models a provider serves at /v1/messages work here -- both catalogues
# also carry OpenAI-shaped models on /responses and /chat/completions, and the
# only wire adapter in this app is Anthropic-shaped. Zen's Messages subset is
# where claude-opus-4-8 lives; Go's, as of 2026-08-31, is minimax-m3,
# minimax-m2.7, minimax-m2.5, qwen3.8-max, qwen3.8-flash, qwen3.7-max,
# qwen3.7-plus and qwen3.6-plus.
#
# "Config, not code" above is the relay's half of the story. The page's Provider
# dropdown is built from web/js/providers/index.js, so a provider the relay has
# never heard of also needs one object there -- reusing the ANTHROPIC adapter if
# its endpoint speaks Messages -- before anyone can select it.
#
# Only the anthropic entry gets thinking, effort and native structured output;
# the gateways are sent the plain Messages shape, since they do not implement
# Anthropic's newest parameters. That is set per provider in
# web/js/providers/index.js, not here.
